# ======================================
# CertPath Environment Variables
# ======================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Get Stripe keys from: https://dashboard.stripe.com/test/apikeys
# ======================================

# Stripe API Keys
# Use sk_test_... for testing, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Publishable Key (used by frontend if needed)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Webhook Secret
# Get this when you create a webhook endpoint in Stripe Dashboard
# Dashboard → Developers → Webhooks → Add endpoint
# Endpoint URL: https://yourdomain.com/api/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create in Dashboard → Products)
# Single Course: One-time payment, $4.99
STRIPE_PRICE_COURSE=price_your_course_price_id

# Pro Monthly: Recurring monthly, $9.99/month
STRIPE_PRICE_PRO_MONTHLY=price_your_monthly_price_id

# Pro Yearly: Recurring yearly, $83.88/year
STRIPE_PRICE_PRO_YEARLY=price_your_yearly_price_id

# Client URL (your frontend URL)
CLIENT_URL=http://localhost:5173

# Server Port
PORT=3001
