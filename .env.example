# ======================================
# CertPath Environment Variables (Lemon Squeezy - No CR Needed! 🚀)
# ======================================
# Sign up at: https://lemonsqueezy.com
# Lemon Squeezy is a Merchant of Record (MoR) — NO CR / Business license needed!
# Supports Apple Pay, Google Pay, and all Credit/Debit Cards automatically!
# Payouts go directly to your personal bank account or Wise/PayPal.
# ======================================

# Lemon Squeezy API Key
# Dashboard -> Settings -> API -> New API Key
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here

# Lemon Squeezy Store ID
# Dashboard -> Settings -> Stores (Numeric ID, e.g., 12345)
LEMONSQUEEZY_STORE_ID=your_store_id_here

# Lemon Squeezy Webhook Secret (optional for local testing)
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here

# Lemon Squeezy Product Variant IDs
# Dashboard -> Products -> Create a product -> Copy Variant ID
LEMONSQUEEZY_VARIANT_COURSE=your_course_variant_id
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=your_monthly_variant_id
LEMONSQUEEZY_VARIANT_PRO_YEARLY=your_yearly_variant_id

# Client URL
CLIENT_URL=http://localhost:5173

# Server Port
PORT=3001
