# ======================================
# CertPath Environment Variables (Tap Payments for GCC & Bahrain 🇧🇭)
# ======================================
# Sign up at: https://tap.company
# Tap is the #1 GCC Payment Gateway supporting Bahrain 🇧🇭!
# Includes Apple Pay, BenefitPay, mada, KNET, & Credit/Debit Cards.
# ======================================

# Tap Secret Key (starts with sk_test_... or sk_live_...)
# Get key from Tap Dashboard -> API Keys
TAP_SECRET_KEY=sk_test_your_tap_secret_key_here

# Client URL
CLIENT_URL=http://localhost:5173

# Server Port
PORT=3001
